# ============================================
# 微信AI文章发布系统 - 环境变量配置
# ============================================

# ============================================
# 1. 应用基础配置
# ============================================
# APP_ENV=production 时严格走 ip_whitelist 表 (生产模式)
# APP_ENV=development 时 require_ip_whitelist 自动 bypass (开发模式)
#            避免 docker LAN IP 段变化无常导致"新机器/重启用不了"
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
# 时区设置：影响所有时间计算、Celery 调度、数据库会话等（CELERY_TIMEZONE 已合并到此）
TIMEZONE=Asia/Shanghai
SECRET_KEY=change-this-to-secure-random-key-in-production
APP_HOST=0.0.0.0
APP_PORT=8888
# 管理后台 token (#3): /api/v1/* 端点要求请求头 X-Admin-Token 等于此值
# 部署时请用 `python -c "import secrets; print(secrets.token_urlsafe(32))"` 生成
ADMIN_API_KEY=change-this-to-secure-random-key-min-16-chars
# PII 日志脱敏 salt (#10): openid 在日志中用 HMAC-SHA256(openid, salt) 散列
# 跨部署用不同 salt, 防止不同部署的日志聚合后反向关联同一用户
PII_LOG_SALT=change-me-pii-salt-at-least-8-chars

# JWT 配置 (管理后台登录用)
# JWT_SECRET_KEY 留空则自动使用 SECRET_KEY
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet 加密密钥 (用于加密数据库中存储的敏感配置, 如 AppSecret)
# 部署时请用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成
# 留空则从 SECRET_KEY 派生 (安全但不建议, 生产必须显式设置)
FERNET_KEY=

# IP 白名单: 是否启用 / 信任的代理列表 (逗号分隔)
IP_WHITELIST_ENABLED=true
TRUSTED_PROXIES=

# ⚠️ 生产环境必须修改! 默认密码 admin123 仅限开发/演示环境
ADMIN_DEFAULT_PASSWORD=admin123

# ============================================
# 2. PostgreSQL 配置
# ============================================
PG_HOST=postgres
PG_PORT=5555
PG_USER=wechat_user
PG_PASSWORD=your_secure_postgres_password
PG_DB=wechat_ai_publisher
# 连接池 (SQLAlchemy QueuePool) - 默认值在大多数 4-worker 部署下足够
# 调大前请确认 Postgres max_connections 留出余量 (默认 100)
PG_POOL_SIZE=20
PG_MAX_OVERFLOW=40

# ============================================
# 3. Redis 配置
# ============================================
REDIS_HOST=redis
REDIS_PORT=6666
REDIS_PASSWORD=your_secure_redis_password
REDIS_DB=0
REDIS_CELERY_DB=1
REDIS_CACHE_DB=2

# ============================================
# 4. Kafka 配置
# ============================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9093
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=9093
KAFKA_UI_PORT=9090
KAFKA_CONSUMER_GROUP=wechat-consumer-group
KAFKA_TOPIC_CRAWL=crawl-topics
KAFKA_TOPIC_GENERATE=generate-articles
KAFKA_TOPIC_PUSH=push-notifications
KAFKA_TOPIC_PUBLISH=publish-articles
# 修复 M12: 死信队列 (DLQ) - 持续失败的消息最终送到这里, 便于离线分析
# 不会被自动消费, 需运维定期清理或人工干预
KAFKA_TOPIC_DLQ=wechat-dlq
# 修复 M12: 单条消息最大 poll 重试次数, 超过后转 DLQ + commit offset
# 默认 5, 高并发网络抖动时可调高
KAFKA_CONSUMER_MAX_ATTEMPTS=5

# ============================================
# 5. Celery 配置
# ============================================
CELERY_BROKER_URL=redis://:your_secure_redis_password@redis:6666/1
CELERY_RESULT_BACKEND=redis://:your_secure_redis_password@redis:6666/2
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_POOL=threads
# 单个任务硬超时 (秒), 超时被 worker SIGKILL
# DeepSeek 文章生成典型耗时 30~60s, 默认 1800 (30min) 已留足余量
CELERY_TASK_TIME_LIMIT=1800
# 任务重试间隔 (秒)
CELERY_CRAWL_RETRY_COUNTDOWN=300
CELERY_GENERATE_RETRY_COUNTDOWN=120
CELERY_PUBLISH_RETRY_COUNTDOWN=300
CELERY_PUSH_RETRY_COUNTDOWN=600

# ============================================
# 6. LLM (DeepSeek) API 配置
#    注意: 这里只是"默认供应商"。多供应商(deepseek/openai/minimax/qwen)在
#    管理后台「LLM 供应商」页面配置, 存在 llm_providers 表, 优先级高于本节。
# ============================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
# 可选模型: deepseek-chat / deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=3000
DEEPSEEK_TIMEOUT=60
# 熔断器: 连续失败达到阈值后熔断, 等待 recovery 秒后半开重试
CB_DEEPSEEK_THRESHOLD=5
CB_DEEPSEEK_RECOVERY=60
CB_WECHAT_THRESHOLD=5
CB_WECHAT_RECOVERY=60
CB_CRAWLER_THRESHOLD=5
CB_CRAWLER_RECOVERY=30

# ============================================
# 7. 微信公众平台配置
# ============================================
WECHAT_APP_ID=wx1234567890abcdef
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_TOKEN=your_wechat_token
WECHAT_API_URL=https://api.weixin.qq.com
WECHAT_TIMEOUT=30
# 每日发布配额（订阅号 / 服务号的 freepublish/submit 群发都有每日上限）
# 个人订阅号: 1
# 认证订阅号: 4
# 服务号（认证）: 4
# 超出后微信返回 errcode=45009, 系统会把多余文章保存为草稿待人工发布
WECHAT_DAILY_PUBLISH_QUOTA=1
# 客服消息开关: 未认证个人订阅号没有客服消息接口权限 (errcode=48001)
# true  = 尝试 send_custom_message (认证订阅号 / 服务号)
# false = 跳过客服消息, 不调微信 API 不刷日志 (未认证订阅号)
WECHAT_ENABLE_CUSTOM_MESSAGE=false
# 客服消息可触达窗口 (小时): 只能发给 48h 内互动过的用户, 否则 errcode=45015
WECHAT_MESSAGE_WINDOW_HOURS=48
# 默认封面图 (修复 L12: draft/add 强要求 thumb_media_id)
# 首次发布时自动下载并上传为永久素材, 缓存在 Redis 不重复传
WECHAT_DEFAULT_COVER_URL=https://picsum.photos/seed/wechat-digest/900/383

# ============================================
# 公众号日报 (digest) 配色 (公众号 HTML inline style 用)
# ============================================
# 接受 #RRGGBB / rgb()/ named color; 留空时使用代码内置默认色
# 默认值:
#   标题 = #2C5F8D (深薄荷蓝)
#   简讯 = #5F8D4E (草色)
#   链接 = #7D2E8E (南京大学紫 / "南大紫")
WECHAT_DIGEST_COLOR_TITLE=#2C5F8D
WECHAT_DIGEST_COLOR_BRIEF=#5F8D4E
WECHAT_DIGEST_COLOR_LINK=#7D2E8E

# ============================================
# 8. 调度配置
# ============================================
SCHEDULER_CRAWL_TIME=08:00
SCHEDULER_PUSH_TIME=09:00
SCHEDULER_TOPIC_LIMIT=10
# 推送时每批次最大用户数 (避免一次查太多用户)
PUSH_USER_BATCH_SIZE=1000
# 发布分布式锁 TTL (秒), 防止同一 article 被并发发布
PUBLISH_LOCK_TTL_SECONDS=600

# 爬虫失败时是否回退到 mock：dev 沙箱可设 true，生产永远 false
BAIDU_HOT_USE_MOCK=false
# 爬虫配置：最多取前 N 条热搜
CRAWLER_FETCH_TOP_COUNT=20
# 爬虫配置：解析新闻聚合页时最多抓取候选链接数
CRAWLER_NEWS_RESOLVE_CANDIDATES=60

# ============================================
# 9. 功能开关
# ============================================
ENABLE_CRAWLER=true
# D 方案: 订阅号无客服消息权限, 09:00 客服消息推送对沉睡用户 0 触达
# 改为走 daily_publish_digest (09:30 群发一篇日报), 此开关默认 false
# 认证号 / 服务号保持 true: 配合 WECHAT_ENABLE_CUSTOM_MESSAGE=true 走推送
ENABLE_WECHAT_PUSH=false
ENABLE_AUTO_PUBLISH=false
ENABLE_DEEPSEEK=true
ENABLE_KAFKA=true
ENABLE_CELERY=true

# ============================================
# 10. Nginx 配置
# ============================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================
# 11. CORS 允许的来源（JSON 数组或逗号分隔）
# ============================================
# 默认仅本地 + 示例域名；生产请改成实际的前端域名：
# CORS_ALLOWED_ORIGINS=["https://admin.example.com","https://h5.example.com"]
CORS_ALLOWED_ORIGINS=http://localhost:3333,https://your-domain.com

# ============================================
# 12. Worker 配置
# ============================================
WORKER_CONCURRENCY=4
